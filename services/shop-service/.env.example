# Host port for the hybrid stack's postgres is 5433.
# Credentials and database name must match docker-compose.hybrid.yml.
DATABASE_URL=postgresql://careleo:careleo_dev_password@localhost:5433/careleo_shop

# Must be identical to careleo-backend's JWT_ACCESS_SECRET, otherwise
# shop-service cannot verify admin tokens and every /shop/admin/* call is 401.
JWT_SECRET=super_secret_jwt_key_change_in_prod

PORT=3004
