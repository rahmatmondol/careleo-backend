# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://careleo:careleo_dev_password@localhost:5433/careleo
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=your-secret-key-min-8-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-8-chars
JWT_EXPIRY_HOURS=168

# Firebase Configuration
FIREBASE_PROJECT_ID=careleo-xxxxx
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@careleo-xxxxx.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=careleo-xxxxx.appspot.com

# AI Models Configuration
AI_DEFAULT_MODEL=gpt-3.5-turbo

# API Keys for AI Providers
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
GOOGLE_GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxx

# Legacy service-to-service secret.
# Only read by the /shop/internal/* and /freelancer/internal/* routes, which
# nothing in this repo calls any more — shop and freelancer are modules of this
# process. Keep it only while an older deployed client might still post to them.
# INTERNAL_SERVICE_SECRET=dev_internal_service_secret_change_me

# Media library (was media-service).
# Uploads are served back through /api/v1/media/files/*.
#
# ⚠️ MEDIA_PUBLIC_BASE_URL must be an origin your *clients* can reach, not just
# this machine. On a phone or emulator `localhost` is the device itself, so a
# localhost value makes every catalogue image load blank in careleo-app. Use
# your LAN IP in development and the public API origin in production:
#
#   MEDIA_PUBLIC_BASE_URL=http://192.168.0.103:3000/api/v1/media/files
#
# New uploads are stored as relative paths and resolved against this on read,
# so changing it fixes existing rows too.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_UPLOAD_DIR=./uploads/media
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/api/v1/media/files

# File Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./public/uploads
# If using S3:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_S3_BUCKET=careleo-uploads

# Firebase Cloud Messaging
FCM_SERVER_KEY=AAAAxxx...

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1
