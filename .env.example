# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://careleo:careleo_dev_password@localhost:5433/careleo
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=your-secret-key-min-8-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-8-chars
JWT_EXPIRY_HOURS=168

# Firebase Configuration
FIREBASE_PROJECT_ID=careleo-xxxxx
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@careleo-xxxxx.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=careleo-xxxxx.appspot.com

# AI Models Configuration
AI_DEFAULT_MODEL=gpt-3.5-turbo

# API Keys for AI Providers
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
GOOGLE_GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxx

# WooCommerce Integration
WOO_BASE_URL=https://your-woo-store.com
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxx
WOO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# File Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./public/uploads
