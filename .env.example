# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://careleo:careleo_dev_password@localhost:5433/careleo
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=your-secret-key-min-8-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-8-chars
JWT_EXPIRY_HOURS=168

# Firebase Configuration
FIREBASE_PROJECT_ID=careleo-xxxxx
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@careleo-xxxxx.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=careleo-xxxxx.appspot.com

# AI Models Configuration
AI_DEFAULT_MODEL=gpt-3.5-turbo

# API Keys for AI Providers
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
GOOGLE_GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxx

# Legacy service-to-service secret.
# Only read by the /shop/internal/* and /freelancer/internal/* routes, which
# nothing in this repo calls any more — shop and freelancer are modules of this
# process. Keep it only while an older deployed client might still post to them.
# INTERNAL_SERVICE_SECRET=dev_internal_service_secret_change_me

# Media library (was media-service).
# Uploads are served back through /api/v1/media/files/*.
#
# ⚠️ MEDIA_PUBLIC_BASE_URL must be an origin your *clients* can reach, not just
# this machine. On a phone or emulator `localhost` is the device itself, so a
# localhost value makes every catalogue image load blank in careleo-app. Use
# your LAN IP in development and the public API origin in production:
#
#   MEDIA_PUBLIC_BASE_URL=http://192.168.0.103:3000/api/v1/media/files
#
# New uploads are stored as relative paths and resolved against this on read,
# so changing it fixes existing rows too.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_UPLOAD_DIR=./uploads/media
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/api/v1/media/files

# File Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./public/uploads
# If using S3:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_S3_BUCKET=careleo-uploads

# Firebase Cloud Messaging
FCM_SERVER_KEY=AAAAxxx...

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1

# ── RevenueCat ───────────────────────────────────────────────────────────────
# Subscriptions are sold by the stores (App Store, Play Store) and by
# RevenueCat Web Billing; RevenueCat is the receipt layer in front of all
# three. This app never charges a card — it mirrors what RevenueCat reports
# onto `user_subscriptions`, and which plan a purchase grants is configured per
# plan in the admin Plan Builder (RevenueCat entitlement + per-store product
# ids), not here.
#
# Server secret key (Project settings → API keys → Secret). Used to reconcile a
# customer against RevenueCat after a purchase and from the admin panel.
REVENUECAT_SECRET_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx
#
# The exact string RevenueCat sends as the `Authorization` header on webhook
# deliveries. Set the same value in Integrations → Webhooks; POST
# /api/v1/subscriptions/revenuecat/webhook rejects everything without it, and
# returns 503 until it is set. Generate a long random value.
REVENUECAT_WEBHOOK_AUTH_HEADER=change_me_long_random_string
#
# Public SDK keys, handed to clients by GET /subscriptions/revenuecat/config.
# A blank key disables the paywall on that platform rather than crashing it.
REVENUECAT_IOS_PUBLIC_KEY=appl_xxxxxxxxxxxxxxxxxxxx
REVENUECAT_ANDROID_PUBLIC_KEY=goog_xxxxxxxxxxxxxxxxxxxx
REVENUECAT_WEB_PUBLIC_KEY=rcb_xxxxxxxxxxxxxxxxxxxx
#
# Offering to show by default. Blank uses whichever offering RevenueCat marks
# as current, which is the usual setup.
# REVENUECAT_DEFAULT_OFFERING=
#
# Whether SANDBOX purchases may grant a paid plan. Defaults to true outside
# production and false in it — sandbox purchases cost nothing, so honouring
# them in production is a free Premium button. Set to true temporarily to test
# a TestFlight or Play internal-test build against production.
# REVENUECAT_ALLOW_SANDBOX=false

# ── Outbound email (SMTP) ────────────────────────────────────────────────────
# Required for password reset. The reset token is delivered ONLY by email —
# /auth/forgot-password deliberately never returns it, because that endpoint is
# unauthenticated and returning the token made every account takeable over by
# anyone who knew its email address.
#
# With SMTP_HOST unset the reset email is not sent and the failure is logged;
# the endpoint still answers with its usual generic message, so a customer
# cannot tell the difference. Do not run production this way.
#
# Local development: Mailpit (`docker run -p 1025:1025 -p 8025:8025 axllent/mailpit`)
# catches everything with no credentials — set SMTP_HOST=localhost, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true only for implicit TLS on port 465; port 587 negotiates STARTTLS itself.
SMTP_SECURE=false
MAIL_FROM=CareLeo <no-reply@careleo.care>

# Public origin of the storefront — reset links in emails point here.
APP_PUBLIC_URL=http://localhost:3002
