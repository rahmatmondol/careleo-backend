# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Infrastructure
DATABASE_URL=postgresql://careleo:careleo_dev_password@localhost:5433/careleo
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace_with_secure_access_secret
